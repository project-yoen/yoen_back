      "id": 4,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"expr": "sum(jvm_memory_used_bytes{job=\"yoen-backend\",area=\"heap\"})", "legendFormat": "used heap", "refId": "A"}, {"expr": "sum(jvm_memory_max_bytes{job=\"yoen-backend\",area=\"heap\"})", "legendFormat": "max heap", "refId": "B"}],
      "title": "JVM Heap",
      "type": "timeseries"
    },
